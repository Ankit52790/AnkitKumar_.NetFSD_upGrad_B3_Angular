using System;
using System.Collections.Generic;
using System.Text;

namespace ConsoleApp1
{
    class Program
    {
        static void Main()
        {
            var emp = new Employee("Ankit Kumar", 4500m, 35);

            Console.WriteLine(emp.EmployeeId);
            Console.WriteLine(emp.Salary);

            emp.GiveRaise(15);

            bool success = emp.DeductPenalty(500);

            Console.WriteLine("Penalty Success: " + success);
            Console.WriteLine("Final Salary: " + emp.Salary);
        }
    }
}
