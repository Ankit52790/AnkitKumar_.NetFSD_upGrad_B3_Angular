--Create Trigger to Reduce Stock
CREATE TRIGGER trg_ReduceStock
ON order_items
AFTER INSERT
AS
BEGIN

-- Check for insufficient stock
IF EXISTS
(
    SELECT 1
    FROM stocks s
    JOIN inserted i
    ON s.product_id = i.product_id
    WHERE s.quantity < i.quantity
)
BEGIN
    THROW 50001,'Stock is insufficient for the order.',1;
END

-- Reduce stock
UPDATE s
SET s.quantity = s.quantity - i.quantity
FROM stocks s
JOIN inserted i
ON s.product_id = i.product_id

END

