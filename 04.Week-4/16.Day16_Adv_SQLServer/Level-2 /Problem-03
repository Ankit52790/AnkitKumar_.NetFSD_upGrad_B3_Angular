--Create Database
CREATE DATABASE RetailDB;

--Use Database
USE RetailDB;

--Create Tables

--Stores Table
CREATE TABLE stores (
    store_id INT PRIMARY KEY,
    store_name VARCHAR(100)
);

--Orders Table
CREATE TABLE orders (
    order_id INT PRIMARY KEY,
    store_id INT,
    order_status INT
);

--Products Table
CREATE TABLE products (
    product_id INT PRIMARY KEY,
    price DECIMAL(10,2)
);

--Order_Items Table
CREATE TABLE order_items (
    order_item_id INT PRIMARY KEY,
    order_id INT,
    product_id INT,
    quantity INT,
    discount DECIMAL(10,2)
);

