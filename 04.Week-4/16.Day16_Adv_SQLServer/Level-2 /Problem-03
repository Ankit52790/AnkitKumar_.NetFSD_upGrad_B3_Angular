--Create Temporary Table for Revenue
CREATE TABLE #RevenueTemp
(
    store_id INT,
    order_id INT,
    revenue DECIMAL(12,2)
);

--Cursor-Based Revenue Calculation
BEGIN TRY

BEGIN TRANSACTION

DECLARE @order_id INT
DECLARE @store_id INT
DECLARE @revenue DECIMAL(12,2)

-- Cursor declaration
DECLARE order_cursor CURSOR FOR
SELECT order_id, store_id
FROM orders
WHERE order_status = 4

OPEN order_cursor

FETCH NEXT FROM order_cursor INTO @order_id, @store_id

WHILE @@FETCH_STATUS = 0
BEGIN

SELECT @revenue = SUM((p.price * oi.quantity) - ISNULL(oi.discount,0))
FROM order_items oi
JOIN products p
ON oi.product_id = p.product_id
WHERE oi.order_id = @order_id

INSERT INTO #RevenueTemp
VALUES (@store_id,@order_id,@revenue)

FETCH NEXT FROM order_cursor INTO @order_id, @store_id

END

CLOSE order_cursor
DEALLOCATE order_cursor

COMMIT TRANSACTION

END TRY

BEGIN CATCH

ROLLBACK TRANSACTION

PRINT 'Error occurred during revenue calculation'

END CATCH

--Display Store-wise Revenue Summary
SELECT 
    store_id,
    SUM(revenue) AS total_store_revenue
FROM #RevenueTemp
GROUP BY store_id;
