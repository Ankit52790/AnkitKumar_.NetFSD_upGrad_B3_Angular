--Level-2 Problem 2: Stock Auto-Update Trigger
--Create Database

CREATE DATABASE InventoryDB;

--Use the Database

USE InventoryDB;

--Create Tables
--Products Table
CREATE TABLE products (
    product_id INT PRIMARY KEY,
    product_name VARCHAR(100)
);

--Stocks Table
CREATE TABLE stocks (
    product_id INT PRIMARY KEY,
    quantity INT
);

--Order_Items Table
CREATE TABLE order_items (
    order_item_id INT PRIMARY KEY,
    product_id INT,
    order_qty INT
);

--Insert Sample Data
INSERT INTO products VALUES
(1,'Laptop'),
(2,'Mobile'),
(3,'Tablet');

INSERT INTO stocks VALUES
(1,10),
(2,20),
(3,15);

--Create AFTER INSERT Trigger
CREATE TRIGGER trg_UpdateStockAfterOrder
ON order_items
AFTER INSERT
AS
BEGIN

BEGIN TRY

-- Check if stock is sufficient
IF EXISTS (
    SELECT 1
    FROM stocks s
    JOIN inserted i
    ON s.product_id = i.product_id
    WHERE s.quantity < i.order_qty
)
BEGIN
    THROW 50001, 'Stock is insufficient for this order.', 1;
END

-- Reduce stock quantity
UPDATE s
SET s.quantity = s.quantity - i.order_qty
FROM stocks s
JOIN inserted i
ON s.product_id = i.product_id

END TRY

BEGIN CATCH

ROLLBACK TRANSACTION;

THROW;

END CATCH

END


--Test the Trigger
--Case 1: Valid Order
INSERT INTO order_items VALUES (1,1,3);

--Case 2: Invalid Order (Stock Not Enough)
INSERT INTO order_items VALUES (2,1,20);
