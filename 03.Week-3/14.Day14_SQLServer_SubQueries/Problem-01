SELECT * FROM products;

--Final-Nested Query
SELECT 
--Concatenation
    product_name + ' (' + CAST(model_year AS VARCHAR) + ')' AS product_details,
    list_price,

    (
--Subquery for Category Average\
--This calculates average price of products in the same category.
        SELECT AVG(list_price)
        FROM products p2
        WHERE p2.category_id = p1.category_id
    ) AS avg_price,

--Price Difference Calculation
--list_price - AVG_PRICE
--Shows how much higher the product price is than category average.
    list_price - (
        SELECT AVG(list_price)
        FROM products p2
        WHERE p2.category_id = p1.category_id
    ) AS price_difference

FROM products p1
--WHERE Condition
--WHERE list_price > (subquery)
--This filters only products more expensive than their category average.
WHERE list_price > (
        SELECT AVG(list_price)
        FROM products p2
        WHERE p2.category_id = p1.category_id
);
