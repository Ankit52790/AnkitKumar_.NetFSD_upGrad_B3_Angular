--store_name
--Total Sales:quantity * list_price * (1 - discount)
SELECT s.store_name,CAST(SUM(oi.quantity * oi.list_price * (1 - oi.discount)) AS DECIMAL(10,2)) AS total_sales
FROM stores s
INNER JOIN orders o ON s.store_id = o.store_id
INNER JOIN order_items oi ON o.order_id = oi.order_id

WHERE o.order_status = 4 --Only completed orders ? order_status = 4
--Group by store_name
GROUP BY s.store_name
--Sort by total sales DESC
ORDER BY total_sales DESC;
