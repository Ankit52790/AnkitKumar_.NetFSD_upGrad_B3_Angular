
// Problem 2:Debugging Incorrect Discount Calculation
using System;

namespace DiscountCalculator
{
    class Program
    {
        static void Main(string[] args)
        {
            Console.Write("Product Name :");
            string productName = Console.ReadLine();

            Console.Write("Product Price: ");
            double productPrice = Convert.ToDouble(Console.ReadLine());

            Console.Write("discount percentage: ");
            double discount = Convert.ToDouble(Console.ReadLine());


            //Finding the final price after applying the discount
            double finalPrice = productPrice - (productPrice * discount / 100);

            Console.WriteLine("\n--- Bill Details ---");
            Console.WriteLine("Product :" + productName);
            Console.WriteLine("Original Price: " + productPrice);
            Console.WriteLine("Apply Discount: " + discount + "%");
            Console.WriteLine("Final Price: " + finalPrice);


        }
    }
}
