@model List<MovieCatalogApp.Models.Movie>

<h2 class="mb-3">Movie List</h2>

<div class="mb-3">
    <a asp-action="Create" class="btn btn-primary">+ Add Movie</a>
</div>

<table class="table table-striped table-bordered table-hover shadow">
    <thead class="table-dark">
        <tr>
            <th>Title</th>
            <th>Genre</th>
            <th>Release Date</th>
            <th>Price (₹)</th>
            <th>Rating</th>
            <th style="width:180px;">Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var m in Model)
        {
            <tr>
                <td>@m.Title</td>
                <td>@m.Genre</td>
                <td>@m.ReleaseDate.ToString("dd MMM yyyy")</td>
                <td>₹ @m.Price</td>

                <!-- Rating Badge -->
                <td>
                    <span class="badge 
                        @(m.Rating == "A" ? "bg-success" : 
                          m.Rating == "UA" ? "bg-warning text-dark" : 
                          "bg-secondary")">
                        @m.Rating
                    </span>
                </td>

                <!-- Actions -->
                <td>
                    <a asp-action="Details" asp-route-id="@m.Id" class="btn btn-info btn-sm">View</a>
                    <a asp-action="Edit" asp-route-id="@m.Id" class="btn btn-warning btn-sm">Edit</a>
                    <a asp-action="Delete" asp-route-id="@m.Id" class="btn btn-danger btn-sm"
                       onclick="return confirm('Are you sure you want to delete this movie?');">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
