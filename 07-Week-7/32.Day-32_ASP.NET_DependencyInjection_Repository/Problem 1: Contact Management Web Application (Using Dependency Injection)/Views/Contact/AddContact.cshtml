@model WebApplication2.Models.ContactInfo

<h2>Add Contact</h2>

<form asp-action="AddContact" method="post">

    <div class="form-group">
        <label asp-for="ContactId" class="form-lable"></label>
        <input asp-for="ContactId" class="form-control" />
        <span asp-validation-for="ContactId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="FirstName" class="form-label"></label>
        <input asp-for="FirstName" class="form-control" />
        <!-- Field Validation -->
        <span asp-validation-for="FirstName" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="LastName" class="form-label"></label>
        <input asp-for="LastName" class="form-control" />
    </div>

    <div>
        <label asp-for="CompanyName" class="form-label"></label>
        <input asp-for="CompanyName" class="form-control" />
        <span asp-validation-for="CompanyName" class="text-danger"></span>
    </div>

    <div>
        <label lass="form-label">Email</label>
        <input asp-for="EmailId" class="form-control" />
        <span asp-validation-for="EmailId" class="text-danger"></span>
    </div>

    <div>
        <label class="form-label">Mobile</label>
        <input asp-for="MobileNo" class="form-control" />
    </div>

    <div>
        <label asp-for="Designation" class="form-label"></label>
        <input asp-for="Designation" class="form-control" />
        <span asp-validation-for="Designation" class="text-danger"></span>
    </div>

    <br />
    <button type="submit" class="btn btn-success">Save</button>
    <a asp-action="ShowContacts" class="btn btn-secondary">Back</a>
</form>

<p class="text-danger">@ViewBag.ErrorMessage</p>

@section Scripts {
    <!-- The following line include jQuery validation + Unobtrusive scripts to perform validations -->
    <partial name="_ValidationScriptsPartial" />
}
