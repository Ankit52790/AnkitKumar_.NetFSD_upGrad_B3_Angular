<!DOCTYPE html>
<html>
<head>
    <title>Weather App</title>
</head>
<body>

<h2>Weather Data Fetcher</h2>

<input type="text" id="cityInput" placeholder="Enter city name">
<br><br>

<button onclick="getWeatherPromise()">Get Weather (Promise)</button>
<button onclick="getWeatherAsync()">Get Weather (Async/Await)</button>

<br><br>

<div id="result"></div>

<script>

const resultDiv = document.getElementById("result");

// Promise

const getWeatherPromise = () => {

    const city = document.getElementById("cityInput").value;
    const apiKey = "51a940a9a9ae29f4bf0a2d7583e23a5f";

    const url = `https://api.openweathermap.org/data/2.5/weather?q=${city}&units=metric&appid=${apiKey}`;

    fetch(url)
        .then(response => {
            if (!response.ok) {
                throw new Error("City not found");
            }
            return response.json();
        })
        .then(data => {
            displayWeather(data);
        })
        .catch(error => {
            resultDiv.innerHTML = `<p style="color:red;">${error.message}</p>`;
        });
};


// ASYNC/AWAIT

const getWeatherAsync = async () => {

    const city = document.getElementById("cityInput").value;
    const apiKey = "51a940a9a9ae29f4bf0a2d7583e23a5f";

    const url = `https://api.openweathermap.org/data/2.5/weather?q=${city}&units=metric&appid=${apiKey}`;

    try {
        const response = await fetch(url);

        if (!response.ok) {
            throw new Error("City not found");
        }

        const data = await response.json();
        displayWeather(data);

    } catch (error) {
        resultDiv.innerHTML = `<p style="color:red;">${error.message}</p>`;
    }
};

//  Display output

const displayWeather = (data) => {

    resultDiv.innerHTML = `
        <h3>${data.name}</h3>
        <p>Temperature: ${data.main.temp} °C</p>
        <p>Weather: ${data.weather[0].description}</p>
        <p>Humidity: ${data.main.humidity}%</p>
    `;
};

</script>

</body>
</html>
