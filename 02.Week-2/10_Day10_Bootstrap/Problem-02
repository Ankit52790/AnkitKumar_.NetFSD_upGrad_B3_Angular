<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>ShopPro - E-Commerce Landing</title>

<!-- Bootstrap 5 CDN -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<style>
/*  Custom Theme  */
:root {
    --bs-primary: #6f42c1;
    --bs-secondary: #f8f9fa;
}

body {
    background-color: #f4f6f9;
}

.hero {
    background: linear-gradient(135deg, #6f42c1, #9b6dff);
    color: white;
    padding: 80px 0;
}

.product-card:hover {
    transform: translateY(-5px);
    transition: 0.3s ease;
}
</style>
</head>

<body>

<!--  NAVBAR  -->
<nav class="navbar navbar-dark bg-primary fixed-top">
  <div class="container-fluid">
    <a class="navbar-brand fw-bold" href="#">ShopPro</a>

    <!-- Offcanvas Toggle -->
    <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasMenu">
      <span class="navbar-toggler-icon"></span>
    </button>

    <!-- Offcanvas Menu -->
    <div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasMenu">
      <div class="offcanvas-header">
        <h5 class="offcanvas-title">Menu</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
      </div>
      <div class="offcanvas-body">
        <ul class="navbar-nav">
          <li class="nav-item"><a class="nav-link" href="#">Home</a></li>
          <li class="nav-item"><a class="nav-link" href="#">Shop</a></li>
          <li class="nav-item"><a class="nav-link" href="#">Categories</a></li>
          <li class="nav-item"><a class="nav-link" href="#">Contact</a></li>
        </ul>
      </div>
    </div>
  </div>
</nav>

<!--  HERO SECTION  -->
<section class="hero text-center mt-5">
  <div class="container">
    <h1 class="display-4 fw-bold">Big Sale 2026</h1>
    <p class="lead">Up to 50% off on selected products</p>
    <a href="#" class="btn btn-light btn-lg mt-3">Shop Now</a>
  </div>
</section>

<!--  CAROUSEL -->
<div id="productCarousel" class="carousel slide container my-5" data-bs-ride="carousel">
  <div class="carousel-inner rounded shadow">

    <div class="carousel-item active">
      <img src="https://picsum.photos/1200/400?1" class="d-block w-100">
      <div class="carousel-caption d-none d-md-block">
        <h5>Latest Gadgets</h5>
      </div>
    </div>

    <div class="carousel-item">
      <img src="https://picsum.photos/1200/400?2" class="d-block w-100">
      <div class="carousel-caption d-none d-md-block">
        <h5>Fashion Collection</h5>
      </div>
    </div>

    <div class="carousel-item">
      <img src="https://picsum.photos/1200/400?3" class="d-block w-100">
      <div class="carousel-caption d-none d-md-block">
        <h5>Home Essentials</h5>
      </div>
    </div>

  </div>

  <button class="carousel-control-prev" type="button" data-bs-target="#productCarousel" data-bs-slide="prev">
    <span class="carousel-control-prev-icon"></span>
  </button>

  <button class="carousel-control-next" type="button" data-bs-target="#productCarousel" data-bs-slide="next">
    <span class="carousel-control-next-icon"></span>
  </button>
</div>

<!--  PRODUCT SECTION  -->
<section class="container my-5">
  <h2 class="text-center mb-4 fw-bold">Featured Products</h2>

  <div class="row g-4">

    <div class="col-12 col-sm-6 col-md-4 col-lg-3">
      <div class="card product-card shadow-sm">
        <img src="https://picsum.photos/300/200?4" class="card-img-top">
        <div class="card-body text-center">
          <h6>Wireless Headphones</h6>
          <p class="text-primary fw-bold">₹2,999</p>
          <button class="btn btn-primary btn-sm">Add to Cart</button>
        </div>
      </div>
    </div>

    <div class="col-12 col-sm-6 col-md-4 col-lg-3">
      <div class="card product-card shadow-sm">
        <img src="https://picsum.photos/300/200?5" class="card-img-top">
        <div class="card-body text-center">
          <h6>Smart Watch</h6>
          <p class="text-primary fw-bold">₹4,499</p>
          <button class="btn btn-primary btn-sm">Add to Cart</button>
        </div>
      </div>
    </div>

    <div class="col-12 col-sm-6 col-md-4 col-lg-3">
      <div class="card product-card shadow-sm">
        <img src="https://picsum.photos/300/200?6" class="card-img-top">
        <div class="card-body text-center">
          <h6>Running Shoes</h6>
          <p class="text-primary fw-bold">₹3,199</p>
          <button class="btn btn-primary btn-sm">Add to Cart</button>
        </div>
      </div>
    </div>

    <div class="col-12 col-sm-6 col-md-4 col-lg-3">
      <div class="card product-card shadow-sm">
        <img src="https://picsum.photos/300/200?7" class="card-img-top">
        <div class="card-body text-center">
          <h6>Backpack</h6>
          <p class="text-primary fw-bold">₹1,899</p>
          <button class="btn btn-primary btn-sm">Add to Cart</button>
        </div>
      </div>
    </div>

  </div>
</section>

<!--  NEWSLETTER  -->
<section class="bg-primary text-white py-5">
  <div class="container text-center">
    <h3>Subscribe to Our Newsletter</h3>
    <p>Get updates on latest offers</p>

    <form class="row justify-content-center mt-3">
      <div class="col-12 col-md-6 col-lg-4">
        <input type="email" class="form-control mb-2" placeholder="Enter your email" required>
      </div>
      <div class="col-auto">
        <button class="btn btn-light">Subscribe</button>
      </div>
    </form>
  </div>
</section>

<!--  FOOTER  -->
<footer class="bg-dark text-white text-center py-3">
  © 2026 ShopPro | All Rights Reserved
</footer>

<!-- Bootstrap JS Bundle -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
